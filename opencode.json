{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "kasra": {
      "type": "local",
      "command": [
        "uvx",
        "kasra-mcp-server@latest"
      ],
      "environment": {
        "KASRA_BASE_URL": "https://app.kasralite.com",
        "KASRA_USERNAME": "{env:KASRA_USERNAME}",
        "KASRA_PASSWORD": "{env:KASRA_PASSWORD}"
      },
      "enabled": true
    }
  }
}
